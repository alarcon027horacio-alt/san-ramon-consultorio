<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Consultorio San Ramón | Dr. Horacio Alarcón</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F2F7F6; --surface:#FFFFFF; --ink:#14303A; --muted:#4D6770;
  --teal:#1F6F6B; --teal-ink:#FFFFFF; --rose:#F5DADD; --line:#CFE0DE; --fan:#BFDEDA; --heart:#E0577A;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0F1F24; --surface:#17303A; --ink:#E7F1F0; --muted:#A7BEC2;
    --teal:#5FC4BC; --teal-ink:#0F1F24; --rose:#3A2A30; --line:#274650; --fan:#1F4A50; --heart:#FF8FAE;
  }
}
:root[data-theme="dark"]{
  --bg:#0F1F24; --surface:#17303A; --ink:#E7F1F0; --muted:#A7BEC2;
  --teal:#5FC4BC; --teal-ink:#0F1F24; --rose:#3A2A30; --line:#274650; --fan:#1F4A50; --heart:#FF8FAE;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:17px;line-height:1.6}
a{color:inherit}
.wrap{max-width:880px;margin:0 auto;padding:0 22px}
.btn{display:inline-block;background:var(--teal);color:var(--teal-ink);font-weight:700;text-decoration:none;padding:14px 26px;border-radius:999px;font-size:1.02rem}
.btn:hover{filter:brightness(1.08)}
.btn:focus-visible,a:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.btn.alt{background:transparent;color:var(--ink);border:2px solid var(--ink)}

/* Portada: abanico de ecografía */
.hero{position:relative;overflow:hidden;padding:64px 0 88px}
.hero .fan{position:absolute;right:-90px;top:-30px;width:520px;max-width:none;opacity:.9;z-index:0}

.hero .wrap{position:relative;z-index:1}
.hero h1{font-size:clamp(2.4rem,8vw,4.2rem);line-height:1.04;font-weight:800;letter-spacing:-.02em;margin:0 0 14px}
.hero p.lead{font-size:1.2rem;color:var(--muted);max-width:30ch;margin:0 0 28px}
.hero .doc{font-weight:700;color:var(--ink)}

section{padding:56px 0}
h2{font-size:clamp(1.6rem,5vw,2.2rem);line-height:1.15;margin:0 0 22px;font-weight:800;letter-spacing:-.01em}
.services{display:grid;gap:28px;grid-template-columns:1fr}
@media(min-width:700px){.services{grid-template-columns:1fr 1fr;gap:48px}}
.svc{border-left:4px solid var(--teal);padding-left:18px}
.svc h3{margin:0 0 6px;font-size:1.25rem}
.svc p{margin:0;color:var(--muted)}
.svc.box{border:2px solid var(--teal);border-radius:20px;padding:24px;background:var(--surface)}
.visit{background:var(--rose);border-radius:24px;padding:34px 28px}
.visit p{margin:0 0 10px;max-width:56ch}
.visit p:last-child{margin:0}
.where{display:grid;gap:22px}
@media(min-width:700px){.where{grid-template-columns:1.2fr 1fr;align-items:center}}
.addr{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:26px}
.addr strong{display:block;font-size:1.3rem;margin-bottom:4px}
.addr span{color:var(--muted);display:block;margin-bottom:18px}
.hours{border-left:4px solid var(--teal);padding-left:18px}.hours h3{margin:0 0 8px;font-size:1.25rem}.hours p{margin:0 0 6px;font-size:1.1rem}.hours .note{color:var(--muted);font-size:.95rem}
.contact{text-align:center}
.contact p{color:var(--muted);margin:0 auto 24px;max-width:36ch}
.form{text-align:left;max-width:460px;margin:0 auto;display:grid;gap:14px}.form label{display:block;font-weight:700;font-size:.95rem}.form input,.form select{display:block;width:100%;margin-top:6px;padding:12px 14px;border:1.5px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);font:inherit;font-weight:400}.form button{border:0;cursor:pointer;font:inherit;font-weight:700}.form .small{font-size:.9rem;text-align:center;margin:0}
[hidden]{display:none!important}
.hp{position:absolute;left:-9999px;opacity:0;height:0;width:0}
.form small{display:block;margin-top:4px;font-weight:400;color:var(--muted);font-size:.85rem}
.done{max-width:460px;margin:0 auto;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:28px}
.done .ok{font-weight:800;font-size:1.2rem;color:var(--teal);margin:0 0 6px}
.done .when{font-weight:800;font-size:1.5rem;line-height:1.2;color:var(--ink);margin:0 0 6px}
.done .what{margin:0 0 20px}
.done .btn{margin:0 0 14px}
.done .small{font-size:.9rem;margin:0 auto 14px}
footer{padding:28px 0 110px;color:var(--muted);font-size:.9rem;text-align:center;border-top:1px solid var(--line)}
.float{position:fixed;left:16px;right:16px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:5;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.25)}
@media(min-width:700px){.float{left:auto;right:24px;width:auto}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <h1>Consultorio<br>San Ramón</h1>
    <p class="lead">Ginecología y ecografías, con el <span class="doc">Dr. Horacio Alarcón</span>.</p>
    <a class="btn" href="#reservar">Reservar turno</a>
  </div>
  <svg class="fan" viewBox="0 0 520 520" aria-hidden="true">
    <defs>
      <radialGradient id="g" cx="50%" cy="0%" r="100%">
        <stop offset="0" stop-color="var(--fan)" stop-opacity="1"/>
        <stop offset="1" stop-color="var(--fan)" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <path d="M260 0 L520 440 A300 300 0 0 1 0 440 Z" fill="url(#g)"/>
    <g fill="none" stroke="var(--teal)" stroke-opacity=".35" stroke-width="1.5">
      <path d="M95 215 A190 190 0 0 0 425 215"/>
      <path d="M60 290 A260 260 0 0 0 460 290"/>
      <path d="M25 370 A340 340 0 0 0 495 370"/>
    </g>
  </svg>
</header>

<main>
  <section>
    <div class="wrap">
      <h2>¿Qué hacemos?</h2>
      <div class="services">
        <div class="svc box">
          <h3>Consultas ginecológicas</h3>
          <p>Control ginecológico y consulta por cualquier duda o molestia, en un espacio tranquilo y con tiempo para escucharte.</p>
        </div>
        <div class="svc box">
          <h3>Ecografías ginecológicas y obstétricas</h3>
          <p>Ecografías ginecológicas y obstétricas, incluido el seguimiento del embarazo y el desarrollo de tu bebé.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="visit">
        <h2>Tu primera visita</h2>
        <p>Podés venir con tus preguntas anotadas. Cualquier duda es una buena razón para consultar.</p>
        <p>Si estás embarazada, traé tus estudios y ecografías anteriores, si los tenés.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Dónde estamos</h2>
      <div class="where">
        <div class="addr">
          <strong>Tucumán y Alberdi</strong>
          <span>Barrio 17 de Octubre</span>
          <a class="btn alt" href="https://maps.app.goo.gl/WQY6YMQMPuKe8XFJ7" target="_blank" rel="noopener">Ver en Google Maps</a>
        </div>
        <div class="hours"><h3>Días y horarios de atención</h3><p><strong>Martes y jueves</strong><br>de 18:30 a 21:30 hs</p><p class="note">Reservá tu turno más abajo.</p></div>
      </div>
    </div>
  </section>

  <section class="contact" id="reservar">
    <div class="wrap">
      <h2>Reservá tu turno</h2>
      <div id="formBox">
        <p>Completá tus datos y elegí el día en que querés venir. Te asignamos el próximo horario libre de ese día.</p>
        <form id="f" class="form">
          <label>Nombre y apellido<input name="nombre" required autocomplete="name"></label>
          <label>Tu WhatsApp<input name="tel" type="tel" required autocomplete="tel" inputmode="tel" placeholder="Ej: 3704 586213"><small>Con código de área, sin 0 ni 15.</small></label>
          <label>¿Qué necesitás?<select name="motivo"><option value="consulta">Consulta ginecológica</option><option value="ecografia">Ecografías ginecológicas y obstétricas</option></select></label>
          <label>Día en que querés venir<select name="dia"><option value="martes">Martes</option><option value="jueves">Jueves</option></select><small>Atendemos martes y jueves de 18:30 a 21:30 hs. Te asignamos el próximo horario libre de ese día.</small></label>
          <input class="hp" name="web" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn" type="submit" id="send">Reservar turno</button>
          <p class="small" id="msg" role="status"></p>
        </form>
      </div>
      <div id="done" class="done" hidden>
        <p class="ok">¡Turno reservado!</p>
        <p class="when" id="when"></p>
        <p class="what" id="what"></p>
        <a class="btn" id="waSelf" target="_blank" rel="noopener">Recibir mi turno por WhatsApp</a>
        <p class="small">Si no podés asistir, avisanos por WhatsApp con tiempo.</p>
        <button class="btn alt" type="button" id="again">Reservar otro turno</button>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">Consultorio San Ramón. Dr. Horacio Alarcón.</div>
</footer>

<a class="btn float" href="#reservar">Reservar turno</a>

<script>
  var PHONE = "5493704840452";   // WhatsApp del consultorio (formato internacional)
  var API_URL = "";              // Pegá acá la URL de la aplicación web de Google (termina en /exec)

  function $(id) { return document.getElementById(id); }
  var NL = String.fromCharCode(10);

  // Deja el número en formato internacional de WhatsApp para Argentina (549 + área + número)
  function normPhone(v) {
    var d = String(v).replace(/\D/g, "").replace(/^0+/, "");
    if (d.indexOf("549") === 0) return d;
    if (d.indexOf("54") === 0) return "549" + d.slice(2);
    if (d.length === 12) {
      for (var i = 2; i <= 4; i++) {
        if (d.substr(i, 2) === "15") { d = d.slice(0, i) + d.slice(i + 2); break; }
      }
    }
    return "549" + d;
  }

  function mostrar(r, data) {
    $("formBox").hidden = true;
    $("done").hidden = false;
    $("when").textContent = r.dia + " a las " + r.hora + " hs";
    $("what").textContent = r.motivo + ". Consultorio San Ramón, Dr. Horacio Alarcón.";
    var t = [
      "Turno reservado",
      r.motivo,
      "Día: " + r.dia,
      "Horario: " + r.hora + " hs",
      "Consultorio San Ramón, Dr. Horacio Alarcón",
      "Tucumán y Alberdi, Barrio 17 de Octubre",
      "Ubicación: https://maps.app.goo.gl/WQY6YMQMPuKe8XFJ7"
    ].join(NL);
    $("waSelf").href = "https://wa.me/" + data.tel + "?text=" + encodeURIComponent(t);
    $("done").scrollIntoView({ behavior: "smooth", block: "center" });
  }

  $("again").addEventListener("click", function () {
    $("done").hidden = true;
    $("formBox").hidden = false;
    $("f").reset();
  });

  $("f").addEventListener("submit", function (e) {
    e.preventDefault();
    var d = new FormData(e.target);
    if (d.get("web")) return;   // campo trampa contra robots
    var data = {
      nombre: String(d.get("nombre")).trim(),
      tel: normPhone(d.get("tel")),
      motivo: d.get("motivo"),
      dia: d.get("dia")
    };

    // Modo de respaldo (si todavía no se conectó el sistema de turnos): mensaje al WhatsApp del consultorio
    if (!API_URL) {
      var motivoTxt = data.motivo === "ecografia" ? "Ecografías ginecológicas y obstétricas" : "Consulta ginecológica";
      var t = [
        "Hola, quiero reservar un turno en el Consultorio San Ramón.",
        "Nombre: " + data.nombre,
        "Teléfono: " + data.tel,
        "Motivo: " + motivoTxt,
        "Día que prefiero: " + (data.dia === "jueves" ? "jueves" : "martes")
      ].join(NL);
      window.open("https://wa.me/" + PHONE + "?text=" + encodeURIComponent(t), "_blank", "noopener");
      return;
    }

    var btn = $("send"), msg = $("msg");
    btn.disabled = true;
    btn.textContent = "Reservando...";
    msg.textContent = "";

    fetch(API_URL, {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify(data)
    })
      .then(function (r) { return r.json(); })
      .then(function (r) {
        if (!r.ok) throw new Error(r.error || "error");
        mostrar(r, data);
      })
      .catch(function (err) {
        msg.textContent = (err instanceof TypeError || !err.message)
          ? "No pudimos reservar en este momento. Probá de nuevo o escribinos por WhatsApp."
          : err.message;
      })
      .then(function () {
        btn.disabled = false;
        btn.textContent = "Reservar turno";
      });
  });
</script>
</body>
</html>
